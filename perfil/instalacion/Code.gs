const SPREADSHEET_ID='18XR32ccn4TAa3t5oYNucQ8bO4ld2b7exBR5NZh0pLcg';
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('Mi Perfil de Detective Social').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function registrarPerfil(p){
 if(!p||typeof p.nombre!=='string'||!/^[\\p{L}][\\p{L}\\p{M} .'-]{0,59}$/u.test(p.nombre.trim())||!['3A','3B','4A','4B','5A','5B','6A','6B'].includes(p.grupo)||!Number.isInteger(p.codigo)||p.codigo<1||p.codigo>30||!['inicio','final'].includes(p.momento)||!Array.isArray(p.respuestas)||p.respuestas.length!==18||!p.respuestas.every(v=>Number.isInteger(v)&&v>=1&&v<=4))throw Error('Datos de evaluación no válidos');
 const lock=LockService.getScriptLock();lock.waitLock(15000);
 try{const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName('Respuestas');if(!sh)throw Error('No se encuentra la pestaña Respuestas');const rows=sh.getLastRow();if(rows>1){const entries=sh.getRange(2,2,rows-1,3).getValues();if(entries.some(r=>r[0]===p.grupo&&r[1]==='D'+String(p.codigo).padStart(2,'0')&&r[2]===p.momento))throw Error('Ya existe una evaluación de este grupo, código y momento. Contacta con el profesorado si necesitas corregirla.')}const averages=Array.from({length:6},(_,i)=>Math.round(p.respuestas.slice(i*3,i*3+3).reduce((a,b)=>a+b,0)/3*100)/100);sh.appendRow([new Date(),p.grupo,'D'+String(p.codigo).padStart(2,'0'),p.momento,'v1',...p.respuestas,...averages,p.nombre.trim()]);return {ok:true}}finally{lock.releaseLock()}
}